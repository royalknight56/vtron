{
  "name": "vtron-plus",
  "version": "0.7.4",
  "files": [
    "distlib",
    "distlib/*.css"
  ],
  "main": "distlib/vtron-plus.mjs",
  "module": "distlib/vtron-plus.mjs",
  "style": "distlib/style.css",
  "types": "distlib/packages/plug.d.ts",
  "exports": {
    ".": {
      "types": "./distlib/packages/plug.d.ts",
      "import": "./distlib/vtron-plus.mjs",
      "require": "./distlib/vtron-plus.umd.js"
    },
    "./distlib/style.css": {
      "import": "./distlib/style.css",
      "require": "./distlib/style.css"
    },
    "./virtual-preview-sw.js": "./distlib/virtual-preview-sw.js",
    "./virtual-preview-bridge.html": "./distlib/virtual-preview-bridge.html",
    "./node-worker.mjs": "./distlib/node-worker.mjs",
    "./sync-fs-worker": {
      "types": "./distlib/packages/node/syncFsBridge.d.ts",
      "import": "./distlib/sync-fs-worker.mjs"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build --config vitelib.config.ts",
    "preview": "vite preview",
    "serve": "vite preview",
    "bl": "vue-tsc --noEmit && vite build --config vitelib.config.ts",
    "build-lib": "vite build --config vitelib.config.ts",
    "pub": "npm publish"
  },
  "dependencies": {
    "@babel/standalone": "7.28.5",
    "@jridgewell/trace-mapping": "0.3.9",
    "@liripeng/vue-audio-player": "^1.5.2",
    "@noble/hashes": "2.4.0",
    "@tybys/wasm-util": "0.10.4",
    "@types/node": "^18.16.3",
    "@vue-office/docx": "^1.3.0",
    "@vue-office/excel": "^1.4.1",
    "buffer": "6.0.3",
    "fflate": "0.8.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "mavon-editor": "^3.0.0-beta",
    "monaco-editor": "0.52.2",
    "pyodide": "^0.24.1",
    "readable-stream": "4.7.0",
    "sass": "^1.45.1",
    "semver": "7.7.3",
    "vite-plugin-dts": "^2.0.2",
    "vue-demi": "^0.13.11",
    "xterm": "^5.1.0",
    "xterm-addon-fit": "^0.7.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "isomorphic-fetch": "^3.0.0",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "vtron": "workspace:*",
    "vue": "^3.2.45",
    "vue-tsc": "^1.8.11"
  },
  "peerDependencies": {
    "vtron": "^0.8.3",
    "vue": "^3.2.45"
  }
}
